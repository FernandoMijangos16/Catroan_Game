{
  "name": "catroan",
  "version": "0.9.0",
  "description": "SwapHolm: juego de construcción de pueblos en una isla de hexágonos, low poly 3D en el navegador",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --dev",
    "export-glb": "python3 tools/export-glb.py",
    "lint": "node tools/lint.mjs",
    "start": "node build.mjs && electron .",
    "dist:win": "bash electron/archive-release.sh win && bash electron/build-win.sh",
    "dist:linux": "bash electron/archive-release.sh linux && node build.mjs && electron-builder --linux AppImage",
    "dist": "bash electron/archive-release.sh && bash electron/build-win.sh && electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "peerjs": "1.5.5",
    "terser": "^5.51.4",
    "three": "0.160.0"
  },
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "author": "Fernando Mijangos",
  "build": {
    "appId": "mx.fernando.swapholm",
    "productName": "SwapHolm",
    "directories": {
      "output": "release",
      "buildResources": "electron"
    },
    "files": [
      "electron/*.js",
      "electron/preload.cjs",
      "electron/icon.png",
      "dist/desktop/**",
      "package.json"
    ],
    "win": {
      "icon": "electron/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "SwapHolm-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "SwapHolm-Portable-${version}.${ext}"
    },
    "linux": {
      "icon": "electron/icon.png",
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "SwapHolm-${version}.${ext}",
      "syncDesktopName": true
    }
  },
  "desktopName": "swapholm.desktop",
  "dependencies": {
    "ws": "^8.23.0"
  }
}
